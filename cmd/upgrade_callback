#!/bin/bash
# 升级后置：确保数据目录可写 + 在线构建 server (若 fpk 未内置构建产物)
#
# 与 install_callback 共用 lib.sh，消除两边逻辑漂移。
# 失败语义同 install_callback：致命失败以非零退出。
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-9router}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
CMD_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib.sh
. "${CMD_DIR}/lib.sh"

DATA_DIR="$(9router_resolve_data_dir "${APP_NAME}" "${APP_DIR}")"
LOG="${DATA_DIR}/install.log"

mkdir -p "${DATA_DIR}"
echo "[$(date '+%F %T')] upgrade_callback start" >> "${LOG}"

SRC_DIR="$(9router_find_server_dir "${APP_DIR}")"
if [ -z "${SRC_DIR}" ]; then
    echo "[$(date '+%F %T')] ERROR: server dir not found (tried ${APP_DIR}/server and ${APP_DIR}/target/server)" >> "${LOG}"
    exit 1
fi

# 修正上游开发占位密码 —— 无论是否重建都执行
9router_fix_initial_password "${SRC_DIR}" "${LOG}"

# 若已含构建产物, 跳过在线构建（多路径检测）
if 9router_has_build_artifact "${SRC_DIR}" "${APP_DIR}"; then
    echo "[$(date '+%F %T')] server already built (skip online build)" >> "${LOG}"
    9router_link_node_modules "${SRC_DIR}" "${APP_DIR}" "${LOG}"
    exit 0
fi

echo "[$(date '+%F %T')] online build: npm install + next build..." >> "${LOG}"
if 9router_online_build "${SRC_DIR}" "${DATA_DIR}" "${LOG}"; then
    exit 0
fi

echo "[$(date '+%F %T')] ERROR: online build failed (check install.log)" >> "${LOG}"
exit 1
