#!/bin/bash
# 升级后置：确保数据目录可写 + 在线构建 server (若 fpk 未内置构建产物)
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-9router}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
# 数据目录: 优先 TRIM_PKGVAR (fnOS 注入); 兜底从 APP_DIR 提取卷推导, 不写死 /vol4
APP_VOL=""
if [ -n "${TRIM_PKGVAR:-}" ]; then
    DATA_DIR="${TRIM_PKGVAR}"
else
    if [ -L "${APP_DIR}/home" ]; then
        APP_HOME="$(readlink -f "${APP_DIR}/home")"
        APP_VOL="$(printf '%s' "${APP_HOME}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -z "${APP_VOL}" ]; then
        APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -n "${APP_VOL}" ]; then
        DATA_DIR="${APP_VOL}/@appdata/${APP_NAME}"
    else
        DATA_DIR="${APP_DIR}/var"
    fi
fi
LOG="${DATA_DIR}/install.log"

mkdir -p "${DATA_DIR}"
echo "[$(date '+%F %T')] upgrade_callback start" >> "${LOG}"

# 定位 server 目录
SRC_DIR=""
for cand in "${APP_DIR}/server" "${APP_DIR}/target/server"; do
    [ -d "$cand" ] && SRC_DIR="$cand" && break
done
if [ -z "${SRC_DIR}" ]; then
    echo "[$(date '+%F %T')] ERROR: server dir not found (${APP_DIR}/server)" >> "${LOG}"
    exit 0
fi

# 确保初始密码不是开发占位值 change-me (修正 server 内 .env / .env.example), 无论是否重建都执行
for envf in "${SRC_DIR}/.env" "${SRC_DIR}/.env.example"; do
    if [ -f "$envf" ]; then
        if grep -q '^INITIAL_PASSWORD=change-me' "$envf" 2>/dev/null; then
            sed -i 's/^INITIAL_PASSWORD=change-me.*/INITIAL_PASSWORD=123456/' "$envf" 2>/dev/null || true
            echo "[$(date '+%F %T')] fixed INITIAL_PASSWORD=change-me -> 123456 in $envf" >> "${LOG}"
        fi
    fi
done

# 若已含构建产物, 跳过在线构建
if [ -d "${SRC_DIR}/.next-cli-build" ]; then
    echo "[$(date '+%F %T')] server already built; skip online build" >> "${LOG}"
    exit 0
fi

echo "[$(date '+%F %T')] online build: npm install + next build..." >> "${LOG}"
APP_VOL="$(printf '%s' "${DATA_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
NODE_DIR=""
for cand in /var/apps/nodejs_v24/target/bin "${APP_VOL}/@appcenter/nodejs_v24/bin"; do
    [ -x "$cand/node" ] && NODE_DIR="$cand" && break
done
if [ -z "${NODE_DIR}" ]; then
    echo "[$(date '+%F %T')] ERROR: nodejs_v24 not found; cannot build 9router" >> "${LOG}"
    exit 0
fi
export PATH="${NODE_DIR}:${PATH}"
export HOME="${DATA_DIR}"
export npm_config_jobs=1
export NODE_OPTIONS="--max-old-space-size=1024"

cd "${SRC_DIR}"
npm install --no-audit --no-fund >> "${LOG}" 2>&1
echo "[$(date '+%F %T')] npm install exit=$?" >> "${LOG}"
NEXT_DIST_DIR=.next-cli-build npm run build >> "${LOG}" 2>&1
echo "[$(date '+%F %T')] next build exit=$?" >> "${LOG}"

if [ -d "${SRC_DIR}/.next-cli-build" ]; then
    echo "[$(date '+%F %T')] online build OK" >> "${LOG}"
else
    echo "[$(date '+%F %T')] ERROR: online build did not produce .next-cli-build" >> "${LOG}"
fi

exit 0
